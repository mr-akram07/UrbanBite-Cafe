# ==========================================
# Restaurant Booking & Waitlist Server Config Template
# Copy this file to .env and adjust variables as needed.
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection URI
# Option 1: Local MongoDB (Installed via MongoDB Community Server)
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_booking

# Option 2: MongoDB Atlas Cloud (Free tier)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/restaurant_booking?retryWrites=true&w=majority

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173
